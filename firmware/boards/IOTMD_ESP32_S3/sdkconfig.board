CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The immutable IoTMD core is a Wi-Fi appliance. Optimise it for flash size and
# do not carry upstream MicroPython transports that the supported hardware and
# recovery environment cannot use.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_BT_ENABLED=n
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_PPP_PAP_SUPPORT=n
CONFIG_LWIP_PPP_CHAP_SUPPORT=n
CONFIG_ETH_USE_SPI_ETHERNET=n
CONFIG_ETH_SPI_ETHERNET_W5500=n
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=n
CONFIG_ETH_SPI_ETHERNET_DM9051=n

CONFIG_MBEDTLS_GCM_C=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-IOTMD-8MiB-ota.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
