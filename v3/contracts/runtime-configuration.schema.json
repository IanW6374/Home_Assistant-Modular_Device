{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-md.local/contracts/v3/runtime-configuration.schema.json",
  "title": "IoT-MD v3 runtime configuration",
  "type": "object",
  "required": ["contract_version", "device", "services", "transports", "identity", "fleet", "modules"],
  "properties": {
    "contract_version": {"const": 4},
    "device": {
      "type": "object", "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/name"}},
      "additionalProperties": false
    },
    "services": {
      "type": "object", "required": ["poll_interval_ms", "max_failures"],
      "properties": {
        "poll_interval_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
        "max_failures": {"type": "integer", "minimum": 1, "maximum": 10}
      },
      "additionalProperties": false
    },
    "transports": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "adapter", "enabled", "critical", "dependencies", "settings"],
        "properties": {
          "id": {"$ref": "#/$defs/name"}, "adapter": {"$ref": "#/$defs/name"},
          "enabled": {"type": "boolean"}, "critical": {"type": "boolean"},
          "dependencies": {"$ref": "#/$defs/dependencies"},
          "settings": {"$ref": "#/$defs/settings"}
        },
        "additionalProperties": false
      }
    },
    "identity": {
      "type": "object",
      "required": ["enabled", "method", "critical", "dependencies", "renewal_check_s"],
      "properties": {
        "enabled": {"type": "boolean"},
        "method": {"enum": ["self-signed", "automatic-iot-ca", "iot-ca-authorization", "private-ca-acme", "manual-package"]},
        "critical": {"type": "boolean"},
        "dependencies": {"$ref": "#/$defs/dependencies"},
        "renewal_check_s": {"type": "integer", "minimum": 60, "maximum": 86400}
      },
      "additionalProperties": false
    },
    "fleet": {
      "type": "object",
      "required": ["enabled", "critical", "dependencies", "cohort", "poll_interval_s"],
      "properties": {
        "enabled": {"type": "boolean"}, "critical": {"type": "boolean"},
        "dependencies": {"$ref": "#/$defs/dependencies"},
        "cohort": {"$ref": "#/$defs/name"},
        "poll_interval_s": {"type": "integer", "minimum": 10, "maximum": 86400}
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "driver", "enabled", "resources", "settings"],
        "properties": {
          "id": {"$ref": "#/$defs/name"}, "driver": {"$ref": "#/$defs/name"},
          "enabled": {"type": "boolean"},
          "resources": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {"$ref": "#/$defs/resource"}
          },
          "settings": {"$ref": "#/$defs/settings"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "dependencies": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/name"}},
    "resource": {
      "type": "object", "required": ["kind", "identifier", "shared", "signature", "parameters"],
      "properties": {
        "kind": {"type": "string", "enum": ["adc", "gpio", "i2c", "spi", "uart"]},
        "identifier": {"$ref": "#/$defs/name"},
        "shared": {"type": "boolean"},
        "signature": {"type": "string", "maxLength": 64},
        "parameters": {"$ref": "#/$defs/settings"}
      },
      "allOf": [
        {
          "if": {"properties": {"shared": {"const": true}}},
          "then": {
            "properties": {
              "kind": {"enum": ["i2c", "spi"]},
              "signature": {"minLength": 1}
            }
          },
          "else": {"properties": {"signature": {"maxLength": 0}}}
        },
        {"if": {"properties": {"kind": {"const": "gpio"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/gpioParameters"}}}},
        {"if": {"properties": {"kind": {"const": "adc"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/adcParameters"}}}},
        {"if": {"properties": {"kind": {"const": "uart"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/uartParameters"}}}},
        {"if": {"properties": {"kind": {"const": "i2c"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/i2cParameters"}}}},
        {"if": {"properties": {"kind": {"const": "spi"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/spiParameters"}}}}
      ],
      "additionalProperties": false
    },
    "gpioParameters": {
      "type": "object", "maxProperties": 4,
      "properties": {
        "mode": {"type": "integer", "minimum": 0, "maximum": 2},
        "pull": {"type": "integer", "minimum": 0, "maximum": 2},
        "level": {"type": "integer", "minimum": 0, "maximum": 1},
        "interrupt": {"type": "integer", "minimum": 0, "maximum": 3}
      }, "additionalProperties": false
    },
    "adcParameters": {
      "type": "object", "maxProperties": 2,
      "properties": {
        "attenuation": {"type": "integer", "minimum": 0, "maximum": 12},
        "bitwidth": {"type": "integer", "minimum": 0, "maximum": 13}
      }, "additionalProperties": false
    },
    "uartParameters": {
      "type": "object", "maxProperties": 4,
      "properties": {
        "tx": {"type": "integer", "minimum": -1, "maximum": 48},
        "rx": {"type": "integer", "minimum": -1, "maximum": 48},
        "baudrate": {"type": "integer", "minimum": 300, "maximum": 3000000},
        "rx_buffer": {"type": "integer", "minimum": 128, "maximum": 4096}
      }, "additionalProperties": false
    },
    "i2cParameters": {
      "type": "object", "maxProperties": 3,
      "properties": {
        "sda": {"type": "integer", "minimum": 0, "maximum": 48},
        "scl": {"type": "integer", "minimum": 0, "maximum": 48},
        "frequency": {"type": "integer", "minimum": 10000, "maximum": 1000000}
      }, "additionalProperties": false
    },
    "spiParameters": {
      "type": "object", "maxProperties": 4,
      "properties": {
        "sck": {"type": "integer", "minimum": 0, "maximum": 48},
        "mosi": {"type": "integer", "minimum": -1, "maximum": 48},
        "miso": {"type": "integer", "minimum": -1, "maximum": 48},
        "dma_channel": {"type": "integer", "minimum": 0, "maximum": 3}
      }, "additionalProperties": false
    },
    "settings": {
      "type": "object", "maxProperties": 12,
      "propertyNames": {"pattern": "^[A-Za-z0-9_.:-]{1,32}$"},
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"], "maxLength": 64}
    }
  },
  "additionalProperties": false
}
