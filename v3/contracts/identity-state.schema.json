{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-md.local/contracts/v3/identity-state.schema.json",
  "title": "IoT-MD v3 identity state",
  "type": "object",
  "required": ["contract_version", "generation", "method", "identities", "renewal"],
  "properties": {
    "contract_version": {"const": 1},
    "generation": {"type": "integer", "minimum": 0},
    "method": {"enum": ["self-signed", "automatic-iot-ca", "iot-ca-authorization", "private-ca-acme", "manual-package"]},
    "identities": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["purpose", "certificate_handle", "key_handle", "subject", "issuer", "fingerprint", "not_before", "not_after"],
        "properties": {
          "purpose": {"enum": ["portal", "device-api-fleet", "renewal"]},
          "certificate_handle": {"type": "integer", "minimum": 1},
          "key_handle": {"type": "integer", "minimum": 1},
          "subject": {"type": "string", "minLength": 1, "maxLength": 128},
          "issuer": {"type": "string", "minLength": 1, "maxLength": 128},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "not_before": {"type": "integer", "minimum": 0},
          "not_after": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "renewal": {
      "type": "object", "required": ["managed", "state", "due_at"],
      "properties": {
        "managed": {"type": "boolean"},
        "state": {"enum": ["managed", "manual", "current", "due", "renewing", "error"]},
        "due_at": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
