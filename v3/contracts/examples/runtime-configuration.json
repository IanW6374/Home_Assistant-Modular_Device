{
  "contract_version": 2,
  "device": {"name": "iot-md-001"},
  "services": {"poll_interval_ms": 1000, "max_failures": 3},
  "transports": [
    {
      "id": "wifi",
      "adapter": "wifi",
      "enabled": true,
      "critical": true,
      "dependencies": [],
      "settings": {}
    },
    {
      "id": "connectivity",
      "adapter": "connectivity",
      "enabled": true,
      "critical": false,
      "dependencies": ["wifi"],
      "settings": {}
    },
    {
      "id": "mqtt",
      "adapter": "mqtt",
      "enabled": true,
      "critical": false,
      "dependencies": ["wifi"],
      "settings": {"topic_prefix": "iot-md/iot-md-001"}
    },
    {
      "id": "portal",
      "adapter": "portal",
      "enabled": true,
      "critical": true,
      "dependencies": ["wifi", "connectivity"],
      "settings": {}
    },
    {
      "id": "device-api",
      "adapter": "device-api",
      "enabled": true,
      "critical": false,
      "dependencies": ["wifi", "connectivity"],
      "settings": {}
    }
  ],
  "modules": [
    {
      "id": "reference-1",
      "driver": "reference-sensor",
      "enabled": true,
      "resource": {"kind": "adc", "identifier": "adc:1"},
      "settings": {"scale": 1, "offset": 0}
    }
  ]
}
