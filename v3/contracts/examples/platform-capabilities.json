{
  "abi_version": 4,
  "board": {
    "target": "esp32-s3",
    "revision": "devkitc-n8r8"
  },
  "runtime": {
    "engine": "micropython",
    "version": "1.29.0",
    "platform_abi": 4
  },
  "security": {
    "secure_boot": true,
    "flash_encryption": true,
    "encrypted_nvs": true
  },
  "memory": {
    "psram": true,
    "psram_bytes": 8388608,
    "ota_partition_bytes": 2097152
  },
  "interfaces": {
    "wifi": true,
    "usb_device": true,
    "usb_ncm_hardware": true,
    "usb_ncm_runtime": false,
    "usb_ncm_available": false,
    "ethernet": false
  },
  "storage": {
    "encrypted": true,
    "transactional": true,
    "max_namespaces": 4,
    "max_payload_bytes": 4096
  },
  "updates": {
    "paired_manifest": true,
    "native_trial_observation": true,
    "native_trial_control": true,
    "paired_trial": false,
    "native_rollback": false
  },
  "recovery": {
    "native_state": true,
    "product_independent": true,
    "signed_release": true,
    "qualified": false
  },
  "jobs": {
    "async_worker": true,
    "max_pending": 4,
    "max_events": 8,
    "timeout_ms": 5000,
    "qualified": false
  },
  "resources": {
    "managed": true,
    "max_claims": 16,
    "kinds": ["adc", "gpio", "i2c", "spi", "uart"]
  }
}
