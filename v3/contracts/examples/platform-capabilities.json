{
  "abi_version": 3,
  "board": {
    "target": "esp32-s3",
    "revision": "devkitc-n8r8"
  },
  "runtime": {
    "engine": "micropython",
    "version": "1.29.0",
    "platform_abi": 3
  },
  "security": {
    "secure_boot": true,
    "flash_encryption": true,
    "encrypted_nvs": true
  },
  "memory": {
    "psram": true,
    "psram_bytes": 8388608,
    "ota_partition_bytes": 2097152
  },
  "interfaces": {
    "wifi": true,
    "usb_device": true,
    "usb_ncm_hardware": true,
    "usb_ncm_runtime": false,
    "usb_ncm_available": false,
    "ethernet": false
  },
  "storage": {
    "encrypted": true,
    "transactional": true,
    "max_namespaces": 4,
    "max_payload_bytes": 4096
  },
  "updates": {
    "paired_manifest": true,
    "paired_trial": false,
    "native_rollback": false
  },
  "resources": {
    "managed": true,
    "max_claims": 16,
    "kinds": ["adc", "gpio", "i2c", "spi", "uart"]
  }
}
