{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-md.local/contracts/v3/connectivity-diagnostics.schema.json",
  "title": "IoT-MD v3 connectivity diagnostics",
  "type": "object",
  "required": ["running", "probes"],
  "properties": {
    "running": {"type": "boolean"},
    "probes": {
      "type": "object",
      "required": ["dns", "time", "tls", "mqtt", "ca", "syslog", "release"],
      "properties": {
        "dns": {"$ref": "#/$defs/probe"},
        "time": {"$ref": "#/$defs/probe"},
        "tls": {"$ref": "#/$defs/probe"},
        "mqtt": {"$ref": "#/$defs/probe"},
        "ca": {"$ref": "#/$defs/probe"},
        "syslog": {"$ref": "#/$defs/probe"},
        "release": {"$ref": "#/$defs/probe"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "required": ["state", "attempts", "error"],
      "properties": {
        "state": {"enum": ["unknown", "reachable", "unreachable", "error"]},
        "attempts": {"type": "integer", "minimum": 0},
        "error": {"type": "string", "maxLength": 48}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
