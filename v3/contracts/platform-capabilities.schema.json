{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-md.local/contracts/v3/platform-capabilities.schema.json",
  "title": "IoT-MD v3 platform capabilities",
  "type": "object",
  "required": [
    "abi_version",
    "board",
    "runtime",
    "security",
    "memory",
    "interfaces",
    "storage",
    "updates",
    "recovery",
    "jobs",
    "resources"
  ],
  "properties": {
    "abi_version": {"const": 5},
    "board": {
      "type": "object",
      "required": ["target", "revision"],
      "properties": {
        "target": {"const": "esp32-s3"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 32}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["engine", "version", "platform_abi"],
      "properties": {
        "engine": {"const": "micropython"},
        "version": {"type": "string", "minLength": 1, "maxLength": 32},
        "platform_abi": {"const": 5}
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["secure_boot", "flash_encryption", "encrypted_nvs"],
      "properties": {
        "secure_boot": {"type": "boolean"},
        "flash_encryption": {"type": "boolean"},
        "encrypted_nvs": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["psram", "psram_bytes", "ota_partition_bytes"],
      "properties": {
        "psram": {"type": "boolean"},
        "psram_bytes": {"type": "integer", "minimum": 0},
        "ota_partition_bytes": {"type": "integer", "minimum": 1048576}
      },
      "additionalProperties": false
    },
    "interfaces": {
      "type": "object",
      "required": ["wifi", "usb_device", "usb_ncm_hardware", "usb_ncm_runtime", "usb_ncm_available"],
      "properties": {
        "wifi": {"type": "boolean"},
        "usb_device": {"type": "boolean"},
        "usb_ncm_hardware": {"type": "boolean"},
        "usb_ncm_runtime": {"type": "boolean"},
        "usb_ncm_available": {"type": "boolean"},
        "ethernet": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["encrypted", "transactional", "max_namespaces", "max_payload_bytes"],
      "properties": {
        "encrypted": {"type": "boolean"},
        "transactional": {"type": "boolean"},
        "max_namespaces": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_payload_bytes": {"type": "integer", "minimum": 512, "maximum": 65536}
      },
      "additionalProperties": false
    },
    "updates": {
      "type": "object",
      "required": ["paired_manifest", "native_trial_observation", "native_trial_control", "paired_trial", "native_rollback"],
      "properties": {
        "paired_manifest": {"type": "boolean"},
        "native_trial_observation": {"type": "boolean"},
        "native_trial_control": {"type": "boolean"},
        "paired_trial": {"type": "boolean"},
        "native_rollback": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["native_state", "product_independent", "signed_release", "qualified"],
      "properties": {
        "native_state": {"type": "boolean"},
        "product_independent": {"type": "boolean"},
        "signed_release": {"type": "boolean"},
        "qualified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "required": ["async_worker", "max_pending", "max_events", "timeout_ms", "qualified"],
      "properties": {
        "async_worker": {"type": "boolean"},
        "max_pending": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_events": {"type": "integer", "minimum": 1, "maximum": 32},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
        "qualified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["managed", "physical", "shared_buses", "interrupt_cleanup", "soft_restart_cleanup", "recovery", "qualified", "max_claims", "kinds"],
      "properties": {
        "managed": {"type": "boolean"},
        "physical": {"type": "boolean"},
        "shared_buses": {"type": "boolean"},
        "interrupt_cleanup": {"type": "boolean"},
        "soft_restart_cleanup": {"type": "boolean"},
        "recovery": {"type": "boolean"},
        "qualified": {"type": "boolean"},
        "max_claims": {"type": "integer", "minimum": 1, "maximum": 32},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["adc", "gpio", "i2c", "spi", "uart"]}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
