{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-md.local/contracts/v3/driver-catalog.schema.json",
  "title": "IoT-MD v3 supported driver catalog",
  "type": "array",
  "minItems": 1,
  "maxItems": 16,
  "items": {
    "type": "object",
    "required": ["driver", "types"],
    "properties": {
      "driver": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9_]+$"},
      "types": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+:[A-Za-z0-9_-]+$"}}
    },
    "additionalProperties": false
  }
}
